---
import JaiPlayground from './JaiPlayground.astro';
---
<dialog class="jai-dialog" data-project-demo="jai" aria-label="Code editor">
  <JaiPlayground />
</dialog>
<style>
  .jai-dialog { width: min(94vw, 90rem); max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; inset: 50% auto auto 50%; transform: translate(-50%, -50%); }
  .jai-dialog::backdrop { background: oklch(0% 0 0 / .4); backdrop-filter: blur(.45rem); }
  @media (max-width: 42rem) { .jai-dialog { width: 98vw; } }
</style>
