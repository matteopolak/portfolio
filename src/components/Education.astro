---
import { getProfile } from '../lib/content';
import { sectionHeadings } from '../data/pages';

const { education } = getProfile();
---

<section class="resume-section">
  <h2 class="section-title">{sectionHeadings.education}</h2>
  <article class="resume-entry">
    <div class="resume-entry__heading">
      <div>
        <h3 class="resume-entry__title">{education.degree}</h3>
        <div class="resume-entry__meta">{education.school}</div>
      </div>
      <div class="resume-entry__aside">
        <div>GPA {education.gpa}</div>
        <div>
          <time datetime={education.start}>{education.startLabel}</time>{' '}
          —{' '}
          <time datetime={education.end}>{education.endLabel}</time>
        </div>
      </div>
    </div>
  </article>
</section>
