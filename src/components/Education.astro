---
import config, { formatDate } from '../lib/config';
const { education } = config;
---

<section class="resume-section">
  <h2 class="section-title">Education</h2>
  <article class="resume-entry">
    <div class="resume-entry__heading">
      <div>
        <h3 class="resume-entry__title">{education.degree}</h3>
        <div class="resume-entry__meta">{education.school}</div>
      </div>
      <div class="resume-entry__aside">
        <div>GPA {education.gpa}</div>
        <div>
          <time datetime={education.start.toISOString().slice(0, 7)}>
            {formatDate(education.start)}
          </time>{' '}
          —{' '}
          <time datetime={education.end.toISOString().slice(0, 7)}>
            {formatDate(education.end)}
          </time>
        </div>
      </div>
    </div>
  </article>
</section>
