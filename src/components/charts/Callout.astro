---
/** A highlighted aside for MDX prose. `type` changes the accent and the label. */
interface Props {
  type?: 'note' | 'tip' | 'warning';
  title?: string;
}
const { type = 'note', title } = Astro.props;
const label = { note: 'Note', tip: 'Tip', warning: 'Warning' }[type];
---

<aside class={`callout callout--${type}`}>
  <p class="callout__label">{title ?? label}</p>
  <div class="callout__body"><slot /></div>
</aside>

<style>
  .callout {
    margin: 1.75rem 0;
    padding: 1rem 1.25rem;
    border: 1px solid color-mix(in oklch, var(--callout) 60%, transparent);
    border-radius: var(--radius);
    background: color-mix(in oklch, var(--callout) 8%, transparent);
  }

  .callout--note {
    --callout: var(--accent-2);
    --callout-text: var(--accent-2-text);
  }
  .callout--tip {
    --callout: var(--accent-3);
    --callout-text: var(--accent-3-text);
  }
  .callout--warning {
    --callout: var(--accent-1);
    --callout-text: var(--accent-1-text);
  }

  .callout__label {
    margin: 0 0 0.25rem;
    color: var(--callout-text);
    font-weight: 600;
  }

  .callout__body > :first-child {
    margin-top: 0;
  }

  .callout__body > :last-child {
    margin-bottom: 0;
  }
</style>
