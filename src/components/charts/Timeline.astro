---
import { loadChartData } from '../../lib/charts/data';
import { parseDate } from '../../lib/charts/geometry';
import { longDate } from '../../lib/content/format';
import { chartId } from '../../lib/charts/model';

/** Dated milestones with categories: horizontal columns on wide containers, a vertical list on narrow ones. */
interface Props {
  src: string;
  title?: string;
  caption?: string;
}
const { src, title, caption } = Astro.props;
const { categories, events } = loadChartData('timeline', src);
const id = chartId('Timeline', src, title);
const sorted = [...events].sort((a, b) => a.date.localeCompare(b.date));
const indexOf = (category: string) => Math.max(0, categories.findIndex((c) => c.id === category));
const label = (date: string) => longDate(parseDate(date), date.length > 7);
---

<figure class="timeline" aria-labelledby={title ? `${id}-title` : undefined}>
  {title && <p class="timeline__title" id={`${id}-title`}>{title}</p>}
  {
    categories.length > 1 && (
      <ul class="timeline__legend">
        {categories.map((category, index) => (
          <li>
            <span class={`marker marker--${index + 1}`} aria-hidden="true" />
            {category.label}
          </li>
        ))}
      </ul>
    )
  }
  <ol>
    {
      sorted.map((event) => {
        const index = indexOf(event.category);
        const category = categories[index];
        return (
          <li class={`event event--${index + 1}`}>
            <time datetime={event.date}>{label(event.date)}</time>
            <div class="event__body">
              <span class={`marker marker--${index + 1}`} aria-hidden="true" />
              <strong>{event.title}</strong>
              {categories.length > 1 && <span class="sr-only">{category.label}</span>}
              {event.detail && <span class="event__detail">{event.detail}</span>}
            </div>
          </li>
        );
      })
    }
  </ol>
  {caption && <figcaption class="timeline__caption">{caption}</figcaption>}
</figure>

<style>
  .timeline {
    container-type: inline-size;
    margin: 2rem 0;
  }

  .timeline__title {
    margin: 0 0 0.5rem;
    font-weight: 750;
  }

  .timeline__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0 0 1.25rem;
    padding: 0;
    color: var(--muted);
    font-size: 0.8125rem;
    list-style: none;
  }

  .timeline__legend li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * Date column, then the rule with the event hanging off it. The rule is each
   * body's left border, so it runs unbroken from the first event to the last.
   */
  .event {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    column-gap: 1.25rem;
    /* .prose li adds a bottom margin, which would break the rule between events. */
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  time {
    padding-top: 0.1rem;
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    font-weight: 650;
    text-align: right;
  }

  .event__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0 0 1.4rem 1.25rem;
    border-left: 2px solid var(--soft-rule);
  }

  .event:last-child .event__body {
    padding-bottom: 0;
  }

  .event__body .marker {
    position: absolute;
    top: 0.68rem;
    left: -1px;
    translate: -50% -50%;
  }

  .event__detail {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .timeline__caption {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  /* Solid shapes, one per category: a bar across the rule, a square, a diamond. */
  .marker {
    display: inline-block;
    flex: none;
    background: var(--marker);
  }

  .marker--1 {
    --marker: var(--accent-1-text);
    width: 0.9rem;
    height: 0.25rem;
  }

  .marker--2 {
    --marker: var(--accent-2-text);
    width: 0.55rem;
    height: 0.55rem;
  }

  .marker--3 {
    --marker: var(--accent-3-text);
    width: 0.5rem;
    height: 0.5rem;
    rotate: 45deg;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Narrow: the date moves above the title, on the same rule. */
  @container (max-width: 28rem) {
    .event {
      grid-template-columns: minmax(0, 1fr);
    }

    time {
      padding: 0 0 0.1rem 1.25rem;
      border-left: 2px solid var(--soft-rule);
      text-align: left;
    }

    .event__body .marker {
      top: 0.68rem;
    }
  }
</style>
