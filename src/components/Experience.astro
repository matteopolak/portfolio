---
import { getProfile } from '../lib/content';
import { sectionHeadings } from '../data/pages';
import { boldHtml } from '../lib/bold';
import CompanyLogo from './CompanyLogo.astro';

const { experience } = getProfile();
---

<section class="resume-section">
  <h2 class="section-title">{sectionHeadings.experience}</h2>
  <div class="resume-list">
    {
      experience.map((job) => (
        <article class="resume-entry">
          <div class="resume-entry__heading">
            <div>
              <h3 class="resume-entry__title">{job.title}</h3>
              <div class="resume-entry__meta resume-entry__company">
                <CompanyLogo company={job.company} />
                <span>{job.company}</span>
                {
                  job.company === 'Microsoft AI' && (
                    <span class="resume-entry__parent-company">
                      (within <img src="/logos/microsoft.svg" alt="" /> Microsoft)
                    </span>
                  )
                }
              </div>
            </div>
            <div class="resume-entry__aside">
              <div>{job.location}</div>
              <div>
                <time datetime={job.start}>{job.startLabel}</time>{' '}
                —{' '}
                {job.end ? <time datetime={job.end}>{job.endLabel}</time> : 'Present'}
              </div>
            </div>
          </div>
          {job.bullets.length > 0 && (
            <ul>
              {job.bullets.map((achievement) => (
                <li>
                  <Fragment set:html={boldHtml(achievement)} />
                </li>
              ))}
            </ul>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .resume-entry__parent-company {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
  }

  .resume-entry__parent-company img {
    width: 0.85rem;
    height: 0.85rem;
  }
</style>
