---
import DemoModal from './DemoModal.astro';
import ProjectDemoLoading from './ProjectDemoLoading.astro';
---

<DemoModal id="minecraft" label="Minecraft browser demo">
  <div class="project-demo-modal__panel">
    <div class="project-demo-modal__actions">
      <button type="button" data-project-demo-fullscreen aria-label="Enter full screen" title="Full screen">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"></path>
        </svg>
      </button>
      <button type="button" data-project-demo-close aria-label="Close game" title="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m5 5 14 14M19 5 5 19"></path>
        </svg>
      </button>
    </div>
    <div class="project-demo-modal__game" data-project-demo-game></div>
    <ProjectDemoLoading seed="minecraft" />
  </div>
</DemoModal>

<style>
  .project-demo-modal__panel {
    position: relative;
    width: 100%;
    min-width: 0;
    aspect-ratio: 16 / 9;
    background: #0a0a12;
  }

  .project-demo-modal__actions {
    position: absolute;
    top: 0;
    right: -3.4rem;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .project-demo-modal__actions button {
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    padding: 0;
    place-items: center;
    border: 1px solid oklch(100% 0 0 / 0.2);
    color: white;
    background: oklch(9% 0 0 / 0.78);
    box-shadow: 0 0.35rem 1.1rem oklch(0% 0 0 / 0.3);
    backdrop-filter: blur(0.45rem);
    cursor: pointer;
  }

  .project-demo-modal__actions button svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-width: 2;
  }

  .project-demo-modal__actions button:hover {
    background: var(--blue);
  }

  .project-demo-modal__actions button:last-child:hover {
    background: var(--red);
  }

  :global([data-project-demo][data-demo-state='error']) [data-project-demo-fullscreen] {
    display: none;
  }

  .project-demo-modal__actions button:focus-visible {
    outline: 3px solid var(--yellow);
    outline-offset: 3px;
  }

  .project-demo-modal__game {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: #0a0a12;
  }

  @media (max-width: 42rem) {
    .project-demo-modal__actions {
      top: -2.85rem;
      right: 0;
      flex-direction: row;
      gap: 0.35rem;
    }

    .project-demo-modal__actions button {
      width: 2.35rem;
      height: 2.35rem;
    }
  }
</style>
