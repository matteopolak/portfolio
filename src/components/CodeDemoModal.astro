---
import CodeWorkspace from './CodeWorkspace.astro';
import DemoModal from './DemoModal.astro';

interface Props {
  id: 'jai' | 'quasi' | 'baerscript';
  label: string;
  starter?: string;
  files?: boolean;
  enabled?: boolean;
  revision?: string;
}

const { id, label, ...workspace } = Astro.props;
---

<DemoModal id={id} label={`${label} editor`} variant="workspace">
  <CodeWorkspace language={id} label={label} {...workspace} />
</DemoModal>
