---
import config from '../lib/config';
import { canonicalPathname } from '../lib/urls';
import faviconSvgUrl from '../assets/favicon.svg?url&no-inline';
import appleTouchIconUrl from '../generated/favicons/apple-touch-icon.png?url&no-inline';
import favicon32Url from '../generated/favicons/favicon-32x32.png?url&no-inline';
import icon512Url from '../generated/favicons/icon-512.png?url&no-inline';
import openSansUrl from '@fontsource-variable/open-sans/files/open-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  pageTitle: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const { title, pageTitle, description, type = 'website', publishedTime } = Astro.props;
const canonicalUrl = new URL(canonicalPathname(Astro.url.pathname), Astro.site);
const socialImageUrl = new URL(icon512Url, Astro.site);
const personId = new URL('/#person', Astro.site).href;
const websiteId = new URL('/#website', Astro.site).href;
const pageId = `${canonicalUrl.href}#webpage`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: config.name,
      url: new URL('/', Astro.site).href,
      sameAs: [
        `https://github.com/${config.github}`,
        `https://www.linkedin.com/in/${config.linkedin}`,
      ],
      jobTitle: 'Software Engineer',
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: new URL('/', Astro.site).href,
      name: config.name,
      description: config.description,
      inLanguage: 'en-CA',
      publisher: { '@id': personId },
    },
    type === 'article'
      ? {
          '@type': 'BlogPosting',
          '@id': pageId,
          url: canonicalUrl.href,
          headline: pageTitle,
          ...(description ? { description } : {}),
          ...(publishedTime ? { datePublished: publishedTime } : {}),
          inLanguage: 'en-CA',
          author: { '@id': personId },
          isPartOf: { '@id': websiteId },
          mainEntityOfPage: canonicalUrl.href,
        }
      : {
          '@type': 'WebPage',
          '@id': pageId,
          url: canonicalUrl.href,
          name: pageTitle,
          ...(description ? { description } : {}),
          inLanguage: 'en-CA',
          isPartOf: { '@id': websiteId },
          about: { '@id': personId },
        },
  ],
};

const serializedStructuredData = JSON.stringify(structuredData).replaceAll('<', '\\u003c');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="author" content={config.name} />
{description && <meta name="description" content={description} />}
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="preload" href={openSansUrl} as="font" type="font/woff2" crossorigin="anonymous" />
<link rel="icon" type="image/svg+xml" sizes="any" href={faviconSvgUrl} />
<link rel="icon" type="image/png" sizes="32x32" href={favicon32Url} />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconUrl} />
<meta name="apple-mobile-web-app-title" content="Matthew Polak" />
<meta name="theme-color" content="#fdf7e5" />
<title>{title}</title>

<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph -->
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={config.name} />
<meta property="og:locale" content="en_CA" />
<meta property="og:image" content={socialImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="512" />
<meta property="og:image:height" content="512" />
<meta property="og:image:alt" content={`${config.name} monogram`} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={socialImageUrl} />
<meta name="twitter:image:alt" content={`${config.name} monogram`} />

<!-- Article-specific -->
{
  type === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )
}

<script type="application/ld+json" set:html={serializedStructuredData} />
