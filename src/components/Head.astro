---
import config from '../lib/config';
import { canonicalPathname } from '../lib/urls';
import faviconSvgUrl from '../assets/favicon.svg?url&no-inline';
import appleTouchIconUrl from '../generated/favicons/apple-touch-icon.png?url&no-inline';
import favicon32Url from '../generated/favicons/favicon-32x32.png?url&no-inline';
import ogImageUrl from '../generated/favicons/og-image.png?url&no-inline';
import openSansUrl from '@fontsource-variable/open-sans/files/open-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  pageTitle: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const { title, pageTitle, description, type = 'website', publishedTime } = Astro.props;
const canonicalUrl = new URL(canonicalPathname(Astro.url.pathname), Astro.site);
const socialImageUrl = new URL(ogImageUrl, Astro.site);
const personId = new URL('/#person', Astro.site).href;
const websiteId = new URL('/#website', Astro.site).href;
const pageId = `${canonicalUrl.href}#webpage`;
const canonicalPath = canonicalPathname(Astro.url.pathname);
const sectionNames: Record<string, string> = {
  blog: 'Blog',
  projects: 'Projects',
  playground: 'Playground',
};

// Home > section > page, from the URL. The last crumb is the page itself.
const crumbs: { name: string; path: string }[] = [{ name: 'Home', path: '/' }];
const segments = canonicalPath.split('/').filter(Boolean);
segments.forEach((segment, index) => {
  const path = `/${segments.slice(0, index + 1).join('/')}`;
  const last = index === segments.length - 1;
  crumbs.push({
    name: last ? pageTitle : (sectionNames[segment] ?? pageTitle),
    path,
  });
});
const breadcrumbs =
  crumbs.length > 1
    ? {
        '@type': 'BreadcrumbList',
        '@id': `${canonicalUrl.href}#breadcrumb`,
        itemListElement: crumbs.map((crumb, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: crumb.name,
          item: new URL(crumb.path, Astro.site).href,
        })),
      }
    : undefined;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: config.name,
      url: new URL('/', Astro.site).href,
      sameAs: [
        `https://github.com/${config.github}`,
        `https://www.linkedin.com/in/${config.linkedin}`,
      ],
      jobTitle: 'Software Engineer',
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: new URL('/', Astro.site).href,
      name: config.name,
      description: config.description,
      inLanguage: 'en-CA',
      publisher: { '@id': personId },
    },
    type === 'article'
      ? {
          '@type': 'BlogPosting',
          '@id': pageId,
          url: canonicalUrl.href,
          headline: pageTitle,
          ...(description ? { description } : {}),
          ...(publishedTime ? { datePublished: publishedTime } : {}),
          // Posts carry no separate modification date, so it matches publication.
          ...(publishedTime ? { dateModified: publishedTime } : {}),
          image: socialImageUrl.href,
          inLanguage: 'en-CA',
          author: { '@id': personId },
          isPartOf: { '@id': websiteId },
          mainEntityOfPage: canonicalUrl.href,
        }
      : {
          '@type': 'WebPage',
          '@id': pageId,
          url: canonicalUrl.href,
          name: pageTitle,
          ...(description ? { description } : {}),
          inLanguage: 'en-CA',
          isPartOf: { '@id': websiteId },
          about: { '@id': personId },
        },
    ...(breadcrumbs ? [breadcrumbs] : []),
  ],
};

const serializedStructuredData = JSON.stringify(structuredData).replaceAll('<', '\\u003c');
import { themeCss } from '../lib/themes';

// WebMCP origin-trial token (docs/webmcp.md). Rendered only when the variable
// is set at build time; nothing about the page changes without it.
const originTrialToken = import.meta.env.PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN?.trim();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="author" content={config.name} />
{description && <meta name="description" content={description} />}
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="preload" href={openSansUrl} as="font" type="font/woff2" crossorigin="anonymous" />
<link rel="icon" type="image/svg+xml" sizes="any" href={faviconSvgUrl} />
<link rel="icon" type="image/png" sizes="32x32" href={favicon32Url} />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconUrl} />
<meta name="apple-mobile-web-app-title" content="Matthew Polak" />
<meta name="theme-color" content="#fdf7e5" />
{
  originTrialToken && <meta http-equiv="origin-trial" content={originTrialToken} />
}
<style is:inline set:html={themeCss()}></style>
<script is:inline>
  // Applies the saved theme before first paint and keeps it across client-side navigations.
  (function () {
    try {
      var saved = localStorage.getItem('site-theme');
      if (saved && /^[a-z]+$/.test(saved))
        document.documentElement.dataset.siteTheme = saved;
    } catch (error) {
      // Blocked storage: the default theme stays.
    }
    document.addEventListener('astro:before-swap', function (event) {
      var current = document.documentElement.dataset.siteTheme;
      if (current) event.newDocument.documentElement.dataset.siteTheme = current;
      else delete event.newDocument.documentElement.dataset.siteTheme;
    });
  })();
</script>
<title>{title}</title>

<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" type="application/rss+xml" title={`${config.name} — Blog`} href="/rss.xml" />
<link rel="manifest" href="/manifest.webmanifest" />

<!-- Open Graph -->
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={config.name} />
<meta property="og:locale" content="en_CA" />
<meta property="og:image" content={socialImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${config.name} monogram`} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={socialImageUrl} />
<meta name="twitter:image:alt" content={`${config.name} monogram`} />

<!-- Article-specific -->
{
  type === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )
}

<script type="application/ld+json" set:html={serializedStructuredData} />

<script>
  import '../lib/webmcp/boot';
</script>
