---
interface Props {
  id: string;
  label: string;
  /** `media` is a 16:9 stage with an external action column; `workspace` is a full editor surface. */
  variant?: 'media' | 'workspace';
}

const { id, label, variant = 'media' } = Astro.props;
---

<dialog
  class:list={['demo-modal', `demo-modal--${variant}`]}
  data-project-demo={id}
  data-demo-state="loading"
  aria-label={label}
>
  <slot />
</dialog>

<style>
  .demo-modal {
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    outline: 0;
    overflow: visible;
    background: transparent;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
  }

  .demo-modal--media {
    width: min(88vw, calc(86svh * 16 / 9), 88rem);
    height: fit-content;
  }

  .demo-modal--workspace {
    width: min(78rem, calc(100vw - 2rem));
    height: min(54rem, calc(100svh - 2rem));
  }

  .demo-modal[open] {
    animation: demo-modal-enter 210ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
  }

  .demo-modal[open][data-closing='true'] {
    animation: demo-modal-exit 160ms ease-in both;
  }

  .demo-modal::backdrop {
    background: oklch(0% 0 0 / 0.36);
    backdrop-filter: blur(0.45rem);
    animation: demo-backdrop-enter 210ms ease-out both;
  }

  .demo-modal[data-closing='true']::backdrop {
    animation: demo-backdrop-exit 160ms ease-in both;
  }

  @keyframes demo-modal-enter {
    from {
      opacity: 0;
      transform: translate(-50%, -48%) scale(0.975);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  @keyframes demo-modal-exit {
    from {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
    to {
      opacity: 0;
      transform: translate(-50%, -48%) scale(0.985);
    }
  }

  @keyframes demo-sheet-enter {
    from {
      opacity: 0;
      transform: translateY(2.5%);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes demo-sheet-exit {
    from {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: translateY(2.5%);
    }
  }

  @keyframes demo-backdrop-enter {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes demo-backdrop-exit {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @media (max-width: 42rem) {
    .demo-modal--media {
      width: 96vw;
    }

    /* Editors become a full-screen sheet on phones. */
    .demo-modal--workspace {
      inset: 0;
      width: 100%;
      height: 100dvh;
      transform: none;
    }

    .demo-modal--workspace[open] {
      animation-name: demo-sheet-enter;
    }

    .demo-modal--workspace[open][data-closing='true'] {
      animation-name: demo-sheet-exit;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-modal,
    .demo-modal::backdrop {
      animation: none !important;
    }
  }
</style>
