  /* Inactive tabs dim their icon with the label. */
  .ide-filetabs :global(.ide-filetab:not([data-active]) .ide-filetab-icon) {
    opacity: 0.75;
  }

  .ide-filetabs :global(.ide-filetab-readonly) {
    width: 0.75rem;
    height: 0.75rem;
