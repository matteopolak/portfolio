---
import CodeOutput from './CodeOutput.astro';
import ProjectDemoLoading from './ProjectDemoLoading.astro';

interface Props {
  language: 'jai' | 'quasi' | 'baerscript';
  label: string;
  starter?: string;
  files?: boolean;
  enabled?: boolean;
  revision?: string;
}

const { language, label, starter = '', files = false, enabled = true, revision = '' } = Astro.props;
---

<section
  class:list={['ide', `ide--${language}`, !files && 'ide--single']}
  data-code-workspace
  data-code-language={language}
  data-code-starter={starter}
  data-jai-revision={revision}
  data-jai-enabled={String(enabled)}
  data-pane="code"
  data-code-fullscreen-target
  data-project-demo-scroll
>
  <header class="ide-bar">
    <div class="ide-title">
      <span class="ide-mark" aria-hidden="true"></span>
      <span class="ide-name">{label}</span>
      {files && <span class="ide-crumb" data-code-crumb></span>}
    </div>
    <span class="ide-status" data-code-status role="status" aria-live="polite"></span>
    <button type="button" class="ide-text-button" data-code-retry hidden>Retry</button>
    <button type="button" class="ide-run" data-code-run disabled aria-label="Run program" title="Run">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 3.5 16 10 6 16.5Z"></path></svg>
      <span>Run</span>
      <kbd data-code-shortcut>Ctrl↵</kbd>
    </button>
    <button type="button" class="ide-run ide-run--stop" data-code-cancel hidden aria-label="Stop program" title="Stop">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5h10v10H5z"></path></svg>
      <span>Stop</span>
    </button>
    <button type="button" class="ide-text-button ide-vim" data-code-vim aria-pressed="false" aria-label="Vim keybindings" title="Vim keybindings">Vim</button>
    <button type="button" class="ide-icon ide-icon--fullscreen" data-code-fullscreen aria-label="Enter full screen" title="Full screen">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"></path></svg>
    </button>
    <button type="button" class="ide-icon ide-icon--close" data-code-close aria-label="Close editor" title="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
    </button>
  </header>

  <div class="ide-body">
    {
      files && (
        <aside class="ide-files" data-code-files-pane aria-label="Files">
          <div class="ide-pane-head">
            <span>Files</span>
            <span class="ide-pane-actions">
              <button type="button" class="ide-icon ide-icon--small" data-tree-new-file aria-label="New file" title="New file">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 2.5h6l3.5 3.5v11.5h-9.5zM10.25 9v5.5M7.5 11.75H13"></path></svg>
              </button>
              <button type="button" class="ide-icon ide-icon--small" data-tree-new-folder aria-label="New folder" title="New folder">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M2.5 5.5h5.25l1.75 1.75h8v9.25h-15zM10 9.25v5M7.5 11.75h5"></path></svg>
              </button>
            </span>
          </div>
          <nav class="ide-tree" data-code-files aria-label="File tree"></nav>
        </aside>
      )
    }
    {
      files && (
        <div
          class="ide-divider ide-divider--files"
          data-code-resize="files"
          role="separator"
          aria-label="Resize file tree"
          aria-orientation="vertical"
          aria-valuenow="208"
          aria-valuemin="140"
          aria-valuemax="1200"
          tabindex="0"
        />
      )
    }
    <div class="ide-main" data-code-main>
      <div class="ide-editor" data-code-editor></div>
      <div
        class="ide-divider ide-divider--output"
        data-code-resize="output"
        role="separator"
        aria-label="Resize output"
        aria-orientation="horizontal"
        aria-valuenow="176"
        aria-valuemin="72"
        aria-valuemax="1000"
        tabindex="0"
      >
      </div>
      <CodeOutput />
    </div>
    <ProjectDemoLoading seed={language} />
  </div>

  <nav class="ide-tabs" aria-label="Workspace panels">
    {
      files && (
        <button type="button" data-pane-tab="files" aria-selected="false">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M2.5 5.5h5.25l1.75 1.75h8v9.25h-15z"></path></svg>
          Files
        </button>
      )
    }
    <button type="button" data-pane-tab="code" aria-selected="true">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 6-4 4 4 4M13 6l4 4-4 4"></path></svg>
      Code
    </button>
    <button type="button" data-pane-tab="output" aria-selected="false">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 4.5h14v11H3zM6 8l2.5 2L6 12M10.5 12.5h3.5"></path></svg>
      Output
      <span class="ide-tab-dot" aria-hidden="true"></span>
    </button>
  </nav>
</section>

<style>
  .ide {
    --ide-bg: oklch(21% 0.006 270);
    --ide-sunken: oklch(17.5% 0.006 270);
    --ide-raised: oklch(25.5% 0.008 270);
    --ide-hover: oklch(28% 0.009 270);
    --ide-rule: oklch(31% 0.008 270);
    --ide-fg: oklch(90% 0.016 91);
    --ide-fg-strong: oklch(97.598% 0.02449 91.61);
    --ide-muted: oklch(70% 0.012 270);
    --ide-faint: oklch(50% 0.01 270);
    --ide-active-line: oklch(100% 0 0 / 0.035);
    --ide-selection: color-mix(in oklch, var(--blue) 24%, transparent);
    --ide-selection-match: oklch(100% 0 0 / 0.07);
    --ide-search: color-mix(in oklch, var(--yellow) 22%, transparent);
    --ide-search-outline: color-mix(in oklch, var(--yellow) 55%, transparent);
    --ide-syntax-keyword: color-mix(in oklch, var(--yellow) 88%, white);
    --ide-syntax-type: color-mix(in oklch, var(--blue) 52%, white);
    --ide-syntax-function: oklch(94% 0.035 91);
    --ide-syntax-string: oklch(81% 0.11 150);
    --ide-syntax-number: color-mix(in oklch, var(--red) 55%, white);
    --ide-syntax-directive: color-mix(in oklch, var(--red) 72%, white);
    --ide-syntax-comment: oklch(60% 0.014 270);
    --ide-syntax-punct: oklch(74% 0.01 270);
    --ide-error: color-mix(in oklch, var(--red) 58%, white);
    --ide-mono: ui-monospace, 'SFMono-Regular', 'JetBrains Mono', Menlo, Consolas, 'Liberation Mono', monospace;
    --ide-accent: var(--red);

    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    width: 100%;
    height: 100%;
    overflow: hidden;
    color: var(--ide-fg);
    background: var(--ide-bg);
    border: 1px solid oklch(100% 0 0 / 0.08);
    box-shadow:
      0 1.5rem 4rem oklch(0% 0 0 / 0.38),
      0 0.25rem 1rem oklch(0% 0 0 / 0.2);
    color-scheme: dark;
    font-family: var(--font-sans);
  }

  .ide--quasi {
    --ide-accent: var(--blue);
  }

  .ide--baerscript {
    --ide-accent: var(--yellow);
  }

  .ide:fullscreen {
    border: 0;
  }

  .ide button {
    font: inherit;
    color: inherit;
    cursor: pointer;
    border: 0;
    background: transparent;
  }

  .ide button:focus-visible,
  .ide [tabindex]:focus-visible {
    outline: 2px solid var(--yellow);
    outline-offset: -2px;
  }

  .ide [hidden] {
    display: none !important;
  }

  .ide :global(svg) {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Header */
  .ide-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    height: 3rem;
    padding: 0 0.5rem 0 1rem;
    background: var(--ide-sunken);
    border-bottom: 1px solid var(--ide-rule);
  }

  .ide-title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    flex: 1 1 auto;
  }

  .ide-mark {
    width: 0.8rem;
    height: 0.8rem;
    flex: none;
    background: var(--ide-accent);
  }

  .ide-name {
    flex: none;
    color: var(--ide-fg-strong);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .ide-crumb {
    min-width: 0;
    overflow: hidden;
    color: var(--ide-muted);
    font: 0.78rem/1 var(--ide-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ide-crumb:not(:empty)::before {
    content: '/';
    margin-right: 0.65rem;
    color: var(--ide-faint);
  }

  .ide-status {
    min-width: 0;
    overflow: hidden;
    color: var(--ide-muted);
    font-size: 0.78rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ide-text-button {
    height: 2rem;
    padding: 0 0.75rem;
    font-size: 0.8rem !important;
    font-weight: 650 !important;
    border: 1px solid var(--ide-rule) !important;
  }

  .ide-text-button:hover {
    background: var(--ide-hover) !important;
  }

  .ide-vim {
    margin-left: 0.25rem;
    color: var(--ide-muted) !important;
    font-family: var(--ide-mono);
  }

  .ide-vim[aria-pressed='true'] {
    color: var(--ide-fg-strong) !important;
    border-color: var(--blue) !important;
  }

  .ide-run {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2rem;
    padding: 0 0.7rem 0 0.6rem;
    margin-left: 0.25rem;
    color: var(--ink) !important;
    background: var(--yellow) !important;
    font-size: 0.8rem !important;
    font-weight: 700 !important;
    transition: filter 120ms ease;
  }

  .ide-run svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: currentColor;
    stroke: none;
  }

  .ide-run:hover:not(:disabled) {
    filter: brightness(1.08);
  }

  .ide-run:disabled {
    opacity: 0.45;
    cursor: default !important;
  }

  .ide-run kbd {
    padding: 0.1rem 0.3rem;
    font: 600 0.68rem/1 var(--ide-mono);
    background: oklch(0% 0 0 / 0.12);
  }

  .ide-run--stop {
    color: white !important;
    background: var(--red) !important;
  }

  .ide-icon {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    flex: none;
    color: var(--ide-muted) !important;
    transition:
      color 120ms ease,
      background 120ms ease;
  }

  .ide-icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .ide-icon:hover {
    color: var(--ide-fg-strong) !important;
    background: var(--ide-hover) !important;
  }

  .ide-icon--close:hover {
    color: white !important;
    background: var(--red) !important;
  }

  .ide-icon--fullscreen {
    margin-left: 0.25rem;
  }

  .ide-icon--small {
    width: 1.65rem;
    height: 1.65rem;
  }

  .ide-icon--small svg {
    width: 1rem;
    height: 1rem;
  }

  /* Body */
  .ide-body {
    position: relative;
    display: grid;
    grid-template-columns: var(--files-width, 13rem) 1px minmax(0, 1fr);
    min-height: 0;
  }

  .ide--single .ide-body {
    grid-template-columns: minmax(0, 1fr);
  }

  .ide-files {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background: var(--ide-sunken);
  }

  .ide-pane-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    height: 2.25rem;
    flex: none;
    padding: 0 0.35rem 0 1rem;
    color: var(--ide-muted);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .ide-pane-actions {
    display: flex;
  }

  .ide-tree {
    flex: 1;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    padding: 0 0 1rem;
  }

  .ide-tree :global(.tree-row) {
    position: relative;
    display: flex;
    align-items: center;
  }

  .ide-tree :global(.tree-item) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
    min-width: 0;
    height: 1.75rem;
    padding: 0 2rem 0 calc(0.75rem + var(--depth, 0) * 0.9rem);
    color: var(--ide-fg) !important;
    font: 0.8rem/1 var(--ide-mono) !important;
    text-align: left;
    white-space: nowrap;
  }

  .ide-tree :global(.tree-item:hover),
  .ide-tree :global(.tree-row:hover .tree-item) {
    background: var(--ide-hover) !important;
  }

  .ide-tree :global(.tree-item[aria-current]) {
    color: var(--ide-fg-strong) !important;
    background: var(--ide-raised) !important;
    box-shadow: inset 2px 0 var(--blue);
  }

  .ide-tree :global(.tree-icon) {
    width: 1rem;
    height: 1rem;
    color: var(--ide-muted);
  }

  .ide-tree :global(.folder .tree-icon) {
    color: color-mix(in oklch, var(--yellow) 75%, var(--ide-muted));
  }

  .ide-tree :global(.file[aria-current] .tree-icon) {
    color: color-mix(in oklch, var(--blue) 55%, white);
  }

  .ide-tree :global(.tree-chevron) {
    width: 0.85rem;
    height: 0.85rem;
    margin-left: -1rem;
    margin-right: 0.15rem;
    color: var(--ide-faint);
    transition: transform 120ms ease;
  }

  .ide-tree :global(.tree-item[aria-expanded='true'] .tree-chevron) {
    transform: rotate(90deg);
  }

  .ide-tree :global(.file) {
    padding-left: calc(0.75rem + var(--depth, 0) * 0.9rem);
  }

  .ide-tree :global(.folder) {
    padding-left: calc(1.75rem + var(--depth, 0) * 0.9rem);
  }

  .ide-tree :global(.tree-label) {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ide-tree :global(.children) {
    position: relative;
  }

  .ide-tree :global(.children[data-tree-children]:not([data-tree-children=''])::before) {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(1.2rem + (var(--depth, 1) - 1) * 0.9rem);
    width: 1px;
    content: '';
    background: var(--ide-rule);
  }

  .ide-tree :global(.tree-more) {
    position: absolute;
    right: 0.3rem;
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    place-items: center;
    color: var(--ide-muted) !important;
    opacity: 0;
  }

  .ide-tree :global(.tree-row:hover .tree-more),
  .ide-tree :global(.tree-row:focus-within .tree-more),
  .ide-tree :global(.tree-more[aria-expanded='true']) {
    opacity: 1;
  }

  .ide-tree :global(.tree-more:hover) {
    color: var(--ide-fg-strong) !important;
    background: var(--ide-rule) !important;
  }

  .ide-tree :global(.tree-more-icon) {
    width: 1rem;
    height: 1rem;
    stroke-width: 2.6;
  }

  .ide-tree :global(.tree-name-input) {
    display: block;
    width: calc(100% - 0.75rem - var(--depth, 0) * 0.9rem - 0.5rem);
    height: 1.65rem;
    margin: 0.05rem 0.5rem 0.05rem calc(0.75rem + var(--depth, 0) * 0.9rem);
    padding: 0 0.45rem;
    color: var(--ide-fg-strong);
    background: var(--ide-bg);
    border: 1px solid var(--blue);
    border-radius: 0;
    outline: none;
    font: 0.8rem/1 var(--ide-mono);
  }

  .ide-tree :global(.tree-name-input::placeholder) {
    color: var(--ide-faint);
  }

  .ide :global(.tree-menu) {
    position: absolute;
    z-index: 20;
    min-width: 11rem;
    padding: 0.3rem;
    background: var(--ide-raised);
    border: 1px solid var(--ide-rule);
    box-shadow: 0 0.75rem 2rem oklch(0% 0 0 / 0.45);
  }

  .ide :global(.tree-menu button) {
    display: block;
    width: 100%;
    padding: 0.45rem 0.7rem;
    color: var(--ide-fg);
    font-size: 0.8rem;
    text-align: left;
  }

  .ide :global(.tree-menu button:hover),
  .ide :global(.tree-menu button:focus) {
    color: var(--ide-fg-strong);
    background: var(--ide-hover);
    outline: none;
  }

  .ide :global(.tree-menu button[data-danger]) {
    color: var(--ide-error);
  }

  .ide-main {
    display: grid;
    grid-template-rows: minmax(0, 1fr) 1px var(--output-height, 11rem);
    min-width: 0;
    min-height: 0;
  }

  .ide[data-output-collapsed='true'] .ide-main {
    grid-template-rows: minmax(0, 1fr) 1px auto;
  }

  .ide-editor {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .ide-divider {
    position: relative;
    z-index: 6;
    background: var(--ide-rule);
    touch-action: none;
    transition: background 120ms ease;
  }

  .ide-divider::after {
    position: absolute;
    content: '';
  }

  .ide-divider--files {
    cursor: col-resize;
  }

  .ide-divider--files::after {
    inset: 0 -4px;
  }

  .ide-divider--output {
    cursor: row-resize;
  }

  .ide-divider--output::after {
    inset: -4px 0;
  }

  .ide-divider:hover,
  .ide-divider:focus-visible,
  .ide.resizing .ide-divider {
    background: var(--blue);
    outline: none !important;
  }

  .ide[data-output-collapsed='true'] .ide-divider--output {
    pointer-events: none;
  }

  .ide.resizing {
    user-select: none;
  }

  /* The shared loader covers the body only, so close and retry stay usable. */
  .ide-body :global(.project-demo-loading) {
    z-index: 10;
    color: var(--ide-fg);
    background: var(--ide-bg);
  }

  .ide-body :global(.project-demo-loading p) {
    color: var(--ide-muted);
  }

  .ide-body :global(.project-demo-loading p code) {
    color: var(--ide-fg);
    border-color: var(--ide-rule);
    background: var(--ide-raised);
  }

  /* Narrow-screen tabs */
  .ide-tabs {
    display: none;
  }

  @media (max-width: 42rem) {
    .ide {
      /* iOS zooms the page when focusing text below 16px. */
      --ide-code-size: 16px;

      grid-template-rows: auto minmax(0, 1fr) auto;
      border: 0;
      box-shadow: none;
    }

    .ide-bar {
      height: calc(3.25rem + env(safe-area-inset-top));
      padding: env(safe-area-inset-top) 0.35rem 0 0.85rem;
    }

    .ide-run {
      height: 2.5rem;
      padding: 0 0.9rem 0 0.75rem;
    }

    .ide-run kbd,
    .ide-icon--fullscreen {
      display: none !important;
    }

    .ide-icon {
      width: 2.5rem;
      height: 2.5rem;
    }

    .ide-icon--small {
      width: 2.5rem;
      height: 2.5rem;
    }

    .ide-status {
      display: none;
    }

    .ide-body,
    .ide--single .ide-body {
      grid-template-columns: minmax(0, 1fr);
    }

    .ide-divider {
      display: none;
    }

    .ide-files {
      display: none;
    }

    .ide[data-pane='files'] .ide-files {
      display: flex;
    }

    .ide[data-pane='files'] .ide-main {
      display: none;
    }

    .ide-main,
    .ide[data-output-collapsed='true'] .ide-main {
      grid-template-rows: minmax(0, 1fr);
    }

    .ide[data-pane='code'] .ide-main > :global(.ide-output),
    .ide[data-pane='output'] .ide-editor {
      display: none;
    }

    .ide :global(.ide-output__toggle) {
      display: none !important;
    }

    .ide :global(.ide-output pre) {
      display: block !important;
    }

    .ide-tree :global(.tree-name-input),
    .ide :global(.cm-rename-input),
    .ide :global(.cm-panel input) {
      font-size: 16px !important;
    }

    .ide-tree :global(.tree-item) {
      height: 2.5rem;
      font-size: 0.875rem !important;
    }

    .ide-tree :global(.tree-more) {
      width: 2.25rem;
      height: 2.25rem;
      opacity: 1;
    }

    .ide-tabs {
      display: flex;
      padding-bottom: env(safe-area-inset-bottom);
      background: var(--ide-sunken);
      border-top: 1px solid var(--ide-rule);
    }

    .ide-tabs button {
      position: relative;
      display: flex;
      flex: 1;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.2rem;
      height: 3.5rem;
      color: var(--ide-muted);
      font-size: 0.7rem;
      font-weight: 650;
    }

    .ide-tabs button svg {
      width: 1.25rem;
      height: 1.25rem;
    }

    .ide-tabs button[aria-selected='true'] {
      color: var(--ide-fg-strong);
    }

    .ide-tabs button[aria-selected='true']::before {
      position: absolute;
      top: -1px;
      left: 25%;
      right: 25%;
      height: 3px;
      content: '';
      background: var(--ide-accent);
    }

    .ide-tab-dot {
      position: absolute;
      top: 0.7rem;
      left: calc(50% + 0.55rem);
      display: none;
      width: 0.45rem;
      height: 0.45rem;
      background: var(--yellow);
    }

    .ide[data-output-unread='true'] .ide-tab-dot {
      display: block;
    }
  }
</style>
