  }

  /* Keys go to the program while the canvas has focus: say so with a ring over it. */
  .ide-render__stage::after {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
  }

  .ide-render__stage[data-state='drawing']:has(:global(canvas:focus))::after {
