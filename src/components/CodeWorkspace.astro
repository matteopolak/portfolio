    /* Touch has no hover: every tab shows its close button. */
    .ide-filetabs :global(.ide-filetab-close) {
      width: 2rem;
      height: 2rem;
      margin-right: 0.15rem;
      opacity: 1;
    }

    .ide :global(.ide-output__toggle) {
