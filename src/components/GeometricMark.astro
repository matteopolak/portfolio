---
interface Props {
  name: string;
}

const { name } = Astro.props;

const marks: Record<string, string> = {
  canada: '/logos/canada.svg',
  github: '/logos/github.svg',
  linkedin: '/logos/linkedin.svg',
};

const mark = marks[name];
---

<span class="mark" data-mark={name} aria-hidden="true">
  {mark && <img src={mark} alt="" />}
</span>

<style>
  .mark {
    display: inline-flex;
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
    vertical-align: middle;
  }

  .mark[data-mark='canada'] {
    width: 2rem;
    height: 1rem;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
