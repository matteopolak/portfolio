---
import { ArrowDown } from '@lucide/astro';
const { pathname } = Astro.url;

const links = [
  { name: 'Portfolio', href: '/' },
  { name: 'Blog', href: '/blog' },
  { name: 'Projects', href: '/projects' },
];

const isActive = (href: string) =>
  href === '/'
    ? pathname === '/' || pathname.startsWith('/index')
    : pathname.startsWith(href);
---

<nav class="site-nav" aria-label="Primary navigation">
  <a class="site-nav__mark" href="/" aria-label="Matthew Polak, home">
    <svg viewBox="0 0 56 56" aria-hidden="true">
      <defs>
        <mask id="nav-m-mask">
          <rect width="56" height="56" fill="black" />
          <path
            d="M5 51V5H15L28 23L41 5H51V51H40V22L28 39L16 22V51Z"
            fill="white"
          />
        </mask>
      </defs>
      <g mask="url(#nav-m-mask)">
        <rect width="56" height="56" fill="var(--paper)" />
        <circle class="mark-blue" cx="48" cy="48" r="52" />
        <circle class="mark-red" cx="48" cy="48" r="34" />
        <circle class="mark-yellow" cx="48" cy="48" r="17" />
      </g>
    </svg>
  </a>
  <div class="site-nav__links">
    {
      links.map(({ name, href }) => (
        <a
          href={href}
          aria-current={isActive(href) ? 'page' : undefined}
          class:list={['site-nav__link', { 'is-active': isActive(href) }]}
        >
          {name}
        </a>
      ))
    }
  </div>
  <a
    href="https://github.com/matteopolak/portfolio/releases/download/resume/resume.pdf"
    class="site-nav__resume"
  >
    Résumé <ArrowDown aria-hidden="true" />
  </a>
</nav>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0;
  }

  .site-nav__mark {
    display: grid;
    width: 3.25rem;
    aspect-ratio: 1;
    padding: 0.65rem;
    flex: 0 0 auto;
    place-items: center;
    background: var(--ink);
  }

  .site-nav__mark svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .mark-red {
    fill: var(--red);
  }

  .mark-blue {
    fill: var(--blue);
  }

  .mark-yellow {
    fill: var(--yellow);
  }

  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .site-nav__link,
  .site-nav__resume {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.75rem;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.1;
    text-decoration: none;
  }

  .site-nav__link.is-active {
    font-weight: 800;
    color: var(--ink);
  }

  .site-nav__link.is-active::after {
    position: absolute;
    bottom: -0.1rem;
    left: 50%;
    width: 0.42rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--red);
    transform: translateX(-50%);
    content: '';
  }

  .site-nav__link:nth-child(2).is-active::after {
    background: var(--blue);
  }

  .site-nav__link:nth-child(3).is-active::after {
    background: var(--yellow);
  }

  .site-nav__link:not(.is-active):hover {
    color: var(--ink);
    background: #e4ded1;
  }

  .site-nav__resume {
    margin-left: auto;
    padding: 0.65rem 0.8rem;
    color: var(--ink);
    background: var(--yellow);
  }

  .site-nav__resume:hover {
    color: var(--paper);
    background: var(--red);
  }

  .site-nav__resume :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
    stroke-width: 3;
  }

  @media (max-width: 44rem) {
    .site-nav {
      gap: 0.85rem;
    }

    .site-nav__mark {
      width: 2.75rem;
      padding: 0.55rem;
    }

    .site-nav__links {
      gap: 0;
    }

    .site-nav__link,
    .site-nav__resume {
      font-size: 0.68rem;
    }

    .site-nav__resume {
      padding: 0.55rem 0.6rem;
    }
  }
</style>
