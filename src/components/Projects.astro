---
import { projects } from '../lib/config';
import { bold } from '../lib/bold';
---

<section class="resume-section">
  <h2 class="section-title">Selected work</h2>
  <div class="resume-list">
    {
      projects.map((project) => (
        <article class="resume-entry">
          <div class="resume-entry__heading">
            <div>
              <h3 class="resume-entry__title">
                <a href={`https://github.com/${project.github}`}>
                  {project.title}
                </a>
              </h3>
              {project.tags.length > 0 && (
                <div class="tag-line">{project.tags.join(' · ')}</div>
              )}
            </div>
            <a
              class="resume-entry__aside"
              href={`https://github.com/${project.github}`}
            >
              {project.github} ↗
            </a>
          </div>
          {project.achievements.length > 0 && (
            <ul>
              {project.achievements.map((achievement) => (
                <li>
                  <Fragment set:html={bold(achievement)} />
                </li>
              ))}
            </ul>
          )}
        </article>
      ))
    }
  </div>
</section>
