---
import { getProfile } from '../lib/content';
import { sectionHeadings } from '../data/pages';
import { boldHtml } from '../lib/bold';
import { ExternalLink } from '@lucide/astro';

const { projects } = getProfile();
---

<section class="resume-section">
  <h2 class="section-title">{sectionHeadings.projects}</h2>
  <div class="resume-list">
    {
      projects.map((project) => (
        <article class="resume-entry">
          <div class="resume-entry__heading">
            <div>
              <h3 class="resume-entry__title">
                <a href={project.repository}>
                  {project.title}
                </a>
              </h3>
              {project.tags.length > 0 && (
                <div class="tag-line">{project.tags.join(' · ')}</div>
              )}
            </div>
            <a
              class="resume-entry__aside"
              href={project.repository}
              target="_blank"
              rel="noopener noreferrer"
            >
              {project.github} <ExternalLink aria-hidden="true" size={14} />
            </a>
          </div>
          {project.bullets.length > 0 && (
            <ul>
              {project.bullets.map((achievement) => (
                <li>
                  <Fragment set:html={boldHtml(achievement)} />
                </li>
              ))}
            </ul>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .resume-entry__aside {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: 0.22rem;
  }

  @media (max-width: 44rem) {
    .resume-entry__aside {
      justify-self: start;
    }
  }
</style>
