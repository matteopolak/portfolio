---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { ExternalLink } from '@lucide/astro';
import AnchorLink from './AnchorLink.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  action?: {
    id: string;
    label: string;
  };
  /** Full-page playground route, linked next to the action. */
  playground?: string;
}

const { project, action, playground } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(project);
// Astro's dev content store can retain the pre-schema shape after this optional
// field is introduced. The rendered frontmatter is the same source document and
// keeps the preview accurate; production builds normally use project.data.ai.
const frontmatterAi = remarkPluginFrontmatter.ai as typeof project.data.ai;
const ai = project.data.ai ?? frontmatterAi;
const usage = ai?.usage ?? 'none';
const usageLabel = {
  none: '',
  paired: 'AI-assisted',
  'agent-orchestrated': 'Agent-orchestrated',
}[usage];
const aiFeature = project.data.aiFeature ?? remarkPluginFrontmatter.aiFeature === true;
const aiLabel = [usageLabel, aiFeature && 'Uses AI'].filter(Boolean).join('; ');
const date = project.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});
---

<article class="project-card">
  <h2 class="project-card__heading">
    <span class="project-card__name">
      <a class="project-card__title" href={project.data.website ?? project.data.repository}>
        {project.data.title}
      </a>
      <AnchorLink id={project.id} label={project.data.title} />
    </span>
    {aiLabel && (
      <span class="project-ai" aria-label={`AI usage: ${aiLabel}`}>
        {usage !== 'none' && (
          <span class:list={['project-ai__development', `project-ai__development--${usage}`]}>
            {usageLabel}
          </span>
        )}
        {aiFeature && <span class="project-ai__feature">Uses AI</span>}
      </span>
    )}
  </h2>
  <div class="tag-line">{project.data.tags.join(' · ')}</div>
  <div class="project-card__body"><Content /></div>

  <footer class="project-card__footer">
    <time datetime={project.data.date.toISOString().slice(0, 10)}>{date}</time>
    <div class="project-links">
      {action && (
        <button type="button" data-project-action={action.id} data-project-slug={project.id}>
          {action.label}
        </button>
      )}
      {playground && (
        <a href={playground} data-astro-reload>
          Playground
        </a>
      )}
      {project.data.website && (
        <a href={project.data.website} target="_blank" rel="noopener noreferrer">
          Website <ExternalLink aria-hidden="true" size={12} />
        </a>
      )}
      <a href={project.data.repository} target="_blank" rel="noopener noreferrer">
        GitHub <ExternalLink aria-hidden="true" size={12} />
      </a>
    </div>
  </footer>
</article>

<style>
  .project-card {
    position: relative;
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    /* Same card treatment as the chart tooltips and blog list entries. */
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    background: var(--paper-bright);
    box-shadow: var(--card-shadow);
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .project-card:hover {
    border-color: var(--card-hover-border);
    background-color: var(--card-hover-bg);
    box-shadow: var(--card-hover-shadow);
    transform: translateY(-0.16rem);
  }

  .project-card:has(.project-card__title:focus-visible) {
    outline: 3px solid var(--accent-2-text);
    outline-offset: 3px;
  }

  .project-card__heading,
  .project-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-ai {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 0.7rem;
    padding-top: 0.2rem;
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
  }

  .project-ai__development,
  .project-ai__feature {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
  }

  .project-ai__development::before,
  .project-ai__feature::before {
    width: 1.15rem;
    height: 0.22rem;
    background: var(--ink);
    content: '';
  }

  .project-ai__development--paired::before {
    background: var(--accent-2);
  }

  .project-ai__development--agent-orchestrated::before {
    background: var(--accent-1);
  }

  .project-ai__feature::before {
    background: var(--accent-3);
  }

  .project-card__heading {
    align-items: flex-start;
    margin: 0;
  }

  .project-card__title {
    display: inline;
    font-size: clamp(1.35rem, 2.8vw, 1.9rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  .project-card__title::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    content: '';
  }

  .project-card__title:focus-visible {
    outline: none;
  }

  .project-card__title:hover {
    text-decoration: underline;
  }

  .project-card__body {
    margin-top: 0.7rem;
    font-size: 0.88rem;
  }

  .project-card__body p {
    margin: 0;
  }

  .project-card__footer {
    position: relative;
    z-index: 2;
    align-items: flex-end;
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 0.74rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem;
    font-weight: 700;
  }

  .project-links a,
  .project-links button {
    display: inline-flex;
    align-items: center;
    min-height: 1.9rem;
    padding: 0.32rem 0.5rem;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--accent-2-on);
    background: var(--accent-2);
    font-size: 0.68rem;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
  }

  .project-links a {
    gap: 0.22rem;
  }

  .project-links button {
    color: var(--accent-1-on);
    background: var(--accent-1);
  }

  .project-links a:last-child {
    color: var(--paper);
    background: var(--ink);
  }

  .project-links a:hover,
  .project-links button:hover {
    color: var(--accent-3-on);
    background: var(--accent-3);
  }

  @media (max-width: 52rem) {
    .project-card:hover {
      transform: none;
    }
  }

  @media (max-width: 30rem) {
    .project-card__heading,
    .project-card__footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .project-links {
      justify-content: flex-start;
    }
  }
</style>
