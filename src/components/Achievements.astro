---
import config from '../lib/config';
import { bold } from '../lib/bold';
import type { AchievementLinked } from '../types/config';

function joinLinks(entry: AchievementLinked): string {
  const links = entry.item.map((item) => {
    if (item.pop !== undefined) {
      return `<a href="${item.url}" target="_blank" rel="noopener noreferrer"><span>${item.name}</span> <strong>${item.pop}</strong></a>`;
    }
    return `<a href="${item.url}" target="_blank" rel="noopener noreferrer">${item.name}</a>`;
  });
  let joined: string;
  if (links.length === 1) {
    joined = links[0];
  } else if (links.length === 2) {
    joined = `${links[0]} and ${links[1]}`;
  } else {
    joined = `${links.slice(0, -1).join(', ')}, and ${links[links.length - 1]}`;
  }
  return entry.prefix + joined;
}
---

<section class="resume-section">
  <h2 class="section-title">Achievements</h2>
  <ul class="achievement-list">
    {
      Object.values(config.achievement).map((entry) => (
        <li>
          {'text' in entry ? (
            <Fragment set:html={bold(entry.text)} />
          ) : (
            <Fragment set:html={joinLinks(entry)} />
          )}
        </li>
      ))
    }
  </ul>
</section>
