---
import { getProfile } from '../lib/content';
import { sectionHeadings } from '../data/pages';
import { boldHtml } from '../lib/bold';
import { joinNatural } from '../lib/content/format';

const { achievements } = getProfile();
const escape = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
---

<section class="resume-section">
  <h2 class="section-title">{sectionHeadings.achievements}</h2>
  <ul class="achievement-list">
    {
      achievements.map((entry) => (
        <li>
          {entry.kind === 'text' ? (
            <Fragment set:html={boldHtml(entry.text)} />
          ) : (
            <Fragment
              set:html={
                escape(entry.prefix) +
                joinNatural(
                  entry.items.map((item) =>
                    item.pop !== undefined
                      ? `<a href="${item.url}" target="_blank" rel="noopener noreferrer"><span>${escape(item.name)}</span> <strong>${item.pop}</strong></a>`
                      : `<a href="${item.url}" target="_blank" rel="noopener noreferrer">${escape(item.name)}</a>`
                  )
                )
              }
            />
          )}
        </li>
      ))
    }
  </ul>
</section>
