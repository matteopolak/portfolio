---
import { generateBauhausPattern } from '../lib/bauhaus';
import BauhausPattern from './BauhausPattern.astro';

interface Props {
  seed: string;
}

const { seed } = Astro.props;

const completePatternSeed = (set: number) => {
  for (let attempt = 0; attempt < 10_000; attempt += 1) {
    const candidate = `demo-loader-${seed}-${set}-${attempt}`;
    const pattern = generateBauhausPattern({
      columns: 6,
      rows: 6,
      seed: candidate,
      density: 1,
    });
    if (pattern.shapes.every((shape) => shape.kind !== 'empty')) {
      return candidate;
    }
  }
  throw new Error(`Could not generate a complete loader pattern for ${seed}`);
};

const patternSeeds = Array.from({ length: 3 }, (_, set) =>
  completePatternSeed(set)
);
---

<div class="project-demo-loading" data-project-demo-loading data-state="loading" aria-live="polite">
  <div
    class="project-demo-loading__mosaic"
    data-project-demo-loading-progress
    role="progressbar"
    aria-label="Loading demo"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    {
      patternSeeds.map((patternSeed, index) => (
        <div
          class="project-demo-loading__pattern"
          style={`--pattern-delay: ${index * 2.4}s`}
          aria-hidden="true"
        >
          <BauhausPattern
            columns={6}
            rows={6}
            seed={patternSeed}
            density={1}
            cropEdges={false}
          />
        </div>
      ))
    }
  </div>
  <p data-project-demo-loading-label>Loading demo…</p>
</div>

<style>
  .project-demo-loading {
    position: absolute;
    z-index: 3;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.85rem;
    padding: 1.5rem;
    color: var(--ink);
    background: var(--paper);
    text-align: center;
    transition:
      opacity 180ms ease,
      visibility 180ms ease;
  }

  :global([data-project-demo][data-demo-state='ready']) .project-demo-loading {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .project-demo-loading__mosaic {
    position: relative;
    width: 5.4rem;
    aspect-ratio: 1;
  }

  .project-demo-loading__pattern {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .project-demo-loading__pattern :global(.pattern-region) {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.82);
    animation: project-demo-cell-cycle 7.2s ease-in-out infinite both;
    animation-delay: calc(var(--pattern-delay) + var(--cell-delay, 0ms));
  }

  .project-demo-loading__pattern
    :global(.pattern-region[data-column='0'][data-row='0']) {
    --cell-delay: 0ms;
  }

  .project-demo-loading__pattern
    :global(.pattern-region[data-column='2'][data-row='0']),
  .project-demo-loading__pattern
    :global(.pattern-region[data-column='0'][data-row='2']) {
    --cell-delay: 70ms;
  }

  .project-demo-loading__pattern
    :global(.pattern-region[data-column='4'][data-row='0']),
  .project-demo-loading__pattern
    :global(.pattern-region[data-column='2'][data-row='2']),
  .project-demo-loading__pattern
    :global(.pattern-region[data-column='0'][data-row='4']) {
    --cell-delay: 140ms;
  }

  .project-demo-loading__pattern
    :global(.pattern-region[data-column='4'][data-row='2']),
  .project-demo-loading__pattern
    :global(.pattern-region[data-column='2'][data-row='4']) {
    --cell-delay: 210ms;
  }

  .project-demo-loading__pattern
    :global(.pattern-region[data-column='4'][data-row='4']) {
    --cell-delay: 280ms;
  }

  @keyframes project-demo-cell-cycle {
    0%,
    3% {
      opacity: 0;
      transform: scale(0.82);
    }
    10%,
    25% {
      opacity: 1;
      transform: none;
    }
    33%,
    100% {
      opacity: 0;
      transform: scale(0.94);
    }
  }

  .project-demo-loading p {
    min-height: 1.25em;
    margin: 0;
    color: color-mix(in oklch, var(--ink), transparent 28%);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .project-demo-loading p :global(code) {
    display: inline-block;
    padding: 0.08rem 0.28rem;
    border: 1px solid color-mix(in oklch, var(--ink), transparent 68%);
    color: var(--ink);
    background: color-mix(in oklch, var(--ink), transparent 93%);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9em;
    font-weight: 650;
    line-height: 1.35;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-demo-loading {
      transition: none;
    }

    .project-demo-loading__pattern :global(.pattern-region) {
      animation: none;
    }

    .project-demo-loading__pattern:first-child :global(.pattern-region) {
      opacity: 1;
      transform: none;
    }
  }
</style>
