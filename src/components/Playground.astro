---
import {
  codeDemoPages,
  playgroundPages,
  type PlaygroundName,
} from '../data/code-demos';

/**
 * An inline playground for blog posts. It renders a placeholder card and runs
 * nothing until the reader presses Start; see lib/playground-embed.ts and
 * docs/blog-playground-embed.md.
 */
interface Props {
  name: PlaygroundName;
}

const { name } = Astro.props;
const page = playgroundPages.find(({ id }) => id === name);
if (!page) throw new Error(`Unknown playground "${name}"`);
const { id: _id, ...workspace } =
  codeDemoPages.find(({ id }) => id === name)?.workspace ?? {};
const title = page.title.replace(/ playground$/, '');
---

<div
  class="playground-embed"
  data-playground-embed={name}
  data-playground-embed-props={JSON.stringify(workspace)}
>
  <section class="playground-embed__card" data-playground-embed-card aria-labelledby={`pe-${name}`}>
    <button type="button" class="playground-embed__start" data-playground-embed-start>
      Start
    </button>
    <p class="playground-embed__label" id={`pe-${name}`}>
      {title} <span>· runs in your browser</span>
    </p>
    <noscript><p class="playground-embed__label">Running it needs JavaScript. <a href={page.path}>Open the full page</a>.</p></noscript>
  </section>
  <div class="playground-embed__stage" data-playground-embed-stage hidden></div>
  <button type="button" class="playground-embed__fullscreen" data-playground-embed-fullscreen hidden>
    Full screen
  </button>
</div>

<script>
  import { initializePlaygroundEmbeds } from '../lib/playground-embed';

  document.addEventListener('astro:page-load', initializePlaygroundEmbeds);
</script>

<style>
  .playground-embed {
    position: relative;
    margin: 2rem 0;
    aspect-ratio: 16 / 9;
    min-height: 16rem;
    max-height: 80dvh;
    border: 1px solid var(--soft-rule);
    color: var(--ink);
    background: color-mix(in oklch, var(--paper-bright) 75%, transparent);
  }

  .playground-embed__card {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem;
    text-align: center;
  }

  .playground-embed__label {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .playground-embed__label span {
    color: var(--muted);
    font-weight: 500;
  }

  .playground-embed__start {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem 0.6rem 1rem;
    border: 0;
    color: var(--accent-2-on);
    background: var(--accent-2);
    font: 700 0.95rem var(--font-sans);
    cursor: pointer;
  }

  .playground-embed__start::before {
    content: '';
    width: 0;
    height: 0;
    border-block: 0.4em solid transparent;
    border-left: 0.65em solid currentColor;
  }

  .playground-embed__start:disabled::before {
    display: none;
  }

  .playground-embed__start:disabled {
    cursor: progress;
    opacity: 0.7;
  }

  .playground-embed__start:focus-visible,
  .playground-embed__fullscreen:focus-visible {
    outline: 3px solid var(--accent-3);
    outline-offset: 2px;
  }

  .playground-embed__stage {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .playground-embed__fullscreen {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 2;
    padding: 0.3rem 0.65rem;
    border: 1px solid oklch(100% 0 0 / 0.25);
    color: white;
    background: oklch(9% 0 0 / 0.78);
    font: 650 0.78rem var(--font-sans);
    cursor: pointer;
  }

  .playground-embed__fullscreen[hidden] {
    display: none;
  }
</style>
