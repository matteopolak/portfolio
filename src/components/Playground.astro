---
import {
  codeDemoPages,
  playgroundPages,
  type PlaygroundName,
} from '../data/code-demos';

/**
 * An inline playground for blog posts. It renders a placeholder card and runs
 * nothing until the reader presses Start; see lib/playground-embed.ts and
 * docs/blog-playground-embed.md.
 */
interface Props {
  name: PlaygroundName;
}

const { name } = Astro.props;
const page = playgroundPages.find(({ id }) => id === name);
if (!page) throw new Error(`Unknown playground "${name}"`);
const { id: _id, ...workspace } =
  codeDemoPages.find(({ id }) => id === name)?.workspace ?? {};
const title = page.title.replace(/ playground$/, '');
---

<div
  class="playground-embed"
  data-playground-embed={name}
  data-playground-embed-props={JSON.stringify(workspace)}
>
  <section class="playground-embed__card" data-playground-embed-card aria-labelledby={`pe-${name}`}>
    <button
      type="button"
      class="playground-embed__start"
      data-playground-embed-start
      aria-label={`Start the ${title} playground`}
      aria-describedby={`pe-${name}-status`}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z"></path></svg>
    </button>
    <p class="playground-embed__status" id={`pe-${name}-status`} data-playground-embed-status aria-live="polite"></p>
    <p class="playground-embed__label" id={`pe-${name}`}>
      {title} <span>· runs in your browser</span>
    </p>
    <noscript><p class="playground-embed__status">Running it needs JavaScript. <a href={page.path}>Open the full page</a>.</p></noscript>
  </section>
  <div class="playground-embed__stage" data-playground-embed-stage hidden></div>
  <button type="button" class="playground-embed__fullscreen" data-playground-embed-fullscreen hidden>
    Full screen
  </button>
</div>

<script>
  import { initializePlaygroundEmbeds } from '../lib/playground-embed';

  document.addEventListener('astro:page-load', initializePlaygroundEmbeds);
</script>

<style>
  .playground-embed {
    position: relative;
    margin: 2rem 0;
    aspect-ratio: 16 / 9;
    min-height: 16rem;
    max-height: 80dvh;
    border: 1px solid var(--soft-rule);
    border-radius: var(--radius-lg);
    color: var(--ink);
    background: color-mix(in oklch, var(--paper-bright) 75%, transparent);
  }

  .playground-embed__card {
    position: relative;
    display: grid;
    height: 100%;
    place-items: center;
    padding: 1rem;
    text-align: center;
  }

  .playground-embed__label {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    margin: 0;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .playground-embed__label span {
    color: var(--muted);
    font-weight: 500;
  }

  /* Just below the centred button, so the button itself stays centred. */
  .playground-embed__status {
    position: absolute;
    top: calc(50% + 2.75rem);
    right: 1rem;
    left: 1rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .playground-embed__start {
    display: grid;
    width: 4rem;
    height: 4rem;
    padding: 0;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: var(--accent-2-on);
    background: var(--accent-2);
    cursor: pointer;
    transition: transform 120ms ease;
  }

  .playground-embed__start:hover {
    transform: scale(1.06);
  }

  .playground-embed__start svg {
    width: 1.75rem;
    height: 1.75rem;
    fill: currentColor;
  }

  /* Loading: the triangle gives way to a spinner ring. */
  .playground-embed__start:disabled {
    cursor: progress;
    transform: none;
  }

  .playground-embed__start:disabled svg {
    display: none;
  }

  .playground-embed__start:disabled::after {
    width: 1.6rem;
    height: 1.6rem;
    border: 3px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    content: '';
    animation: playground-embed-spin 0.8s linear infinite;
  }

  @keyframes playground-embed-spin {
    to {
      rotate: 1turn;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .playground-embed__start {
      transition: none;
    }

    .playground-embed__start:disabled::after {
      animation-duration: 2.4s;
    }
  }

  .playground-embed__start:focus-visible,
  .playground-embed__fullscreen:focus-visible {
    outline: 3px solid var(--accent-3);
    outline-offset: 2px;
  }

  .playground-embed__stage {
    width: 100%;
    height: 100%;
    overflow: hidden;
    /* Inner radius of the frame, so the workspace inside can't poke past it. */
    border-radius: calc(var(--radius-lg) - 1px);
  }

  .playground-embed__fullscreen {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 2;
    padding: 0.3rem 0.65rem;
    border: 1px solid oklch(100% 0 0 / 0.25);
    border-radius: var(--radius-sm);
    color: white;
    background: oklch(9% 0 0 / 0.78);
    font: 650 0.78rem var(--font-sans);
    cursor: pointer;
  }

  .playground-embed__fullscreen[hidden] {
    display: none;
  }
</style>
