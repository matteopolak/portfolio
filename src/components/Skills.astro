---
import config from '../lib/config';
const { skills } = config;
---

<section class="resume-section">
  <h2 class="section-title">Skills</h2>
  <dl class="skills-list">
    <div>
      <dt>Languages</dt>
      <dd>{skills.languages.join(', ')}</dd>
    </div>
    <div>
      <dt>AI & Agent Systems</dt>
      <dd>{skills.agents.join(', ')}</dd>
    </div>
    <div>
      <dt>APIs & Protocols</dt>
      <dd>{skills.protocols.join(', ')}</dd>
    </div>
    <div>
      <dt>Platforms & Tooling</dt>
      <dd>{skills.tools.join(', ')}</dd>
    </div>
  </dl>
</section>
