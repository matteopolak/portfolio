---
import { getProfile } from '../lib/content';
import { sectionHeadings } from '../data/pages';

const { skills } = getProfile();
---

<section class="resume-section">
  <h2 class="section-title">{sectionHeadings.skills}</h2>
  <dl class="skills-list">
    {
      skills.map((group) => (
        <div>
          <dt>{group.label}</dt>
          <dd>{group.items.join(', ')}</dd>
        </div>
      ))
    }
  </dl>
</section>
