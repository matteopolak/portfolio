---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const filtered = headings.filter((heading) => heading.depth <= 3);
---

{
  filtered.length > 0 && (
    <nav id="toc" class="toc" aria-label="Table of contents">
      <p class="toc__label">On this page</p>
      <div class="toc__bar">
        <div id="toc-progress" class="toc__progress" />
      </div>
      <ul>
        {filtered.map((heading) => (
          <li style={`padding-left: ${(heading.depth - 2) * 0.65}rem`}>
            <a href={`#${heading.slug}`} data-toc-id={heading.slug}>
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
