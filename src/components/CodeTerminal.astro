<div class="code-bottom">
  <div class="code-runbar">
    <button type="button" data-code-cancel hidden>Cancel</button>
    <span data-code-status role="status" aria-live="polite"></span>
    <button type="button" data-code-retry hidden>Retry</button>
  </div>
  <pre data-code-output aria-label="Output" aria-live="polite"></pre>
</div>
<style>
  .code-bottom { display: flex; flex-direction: column; min-height: 0; background: #111; color: #eee; }
  .code-runbar { display: flex; align-items: center; gap: .75rem; padding: .55rem .8rem; }
  button { color: inherit; cursor: pointer; border: 0; background: transparent; font: inherit; }
  button:focus-visible { outline: 2px solid #aaa; outline-offset: 2px; }
  button:disabled { opacity: .4; cursor: default; }
  [hidden] { display: none !important; }
  [data-code-cancel], [data-code-status], [data-code-retry] { font-size: .75rem; }
  pre { margin: 0; padding: 0 .9rem .8rem; min-height: 0; flex: 1; overflow: auto; white-space: pre-wrap; font: .78rem/1.65 monospace; }
</style>
