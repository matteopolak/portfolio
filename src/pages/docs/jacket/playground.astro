---
/*
 * The Jacket playground inside the Jacket docs: the docs' header over the
 * shared code workspace. The header's search, theme button and version menu
 * come from the docs' own script (/docs/jacket/assets/site.js, staged from
 * the release's docs tarball), so they behave exactly as on the docs pages.
 * See docs/jacket-docs-playground.md.
 */
import '../../../styles/global.css';
import Head from '../../../components/Head.astro';
import CodeWorkspace from '../../../components/svelte/CodeWorkspace.svelte';
import config from '../../../lib/config';
import { codeDemoPages, JACKET_PLAYGROUND } from '../../../data/code-demos';

const demo = codeDemoPages.find(({ path }) => path === JACKET_PLAYGROUND)!;
const { id, ...workspace } = demo.workspace;
const version = workspace.version ?? '';
const base = '/docs/jacket/';
---

<!doctype html>
<html lang="en" data-theme="system" class="playground-document jacket-docs-page">
  <head>
    <!-- No ClientRouter: every visit starts a fresh runtime. -->
    <Head title={`${demo.title} — ${config.name}`} pageTitle={demo.title} description={demo.description} />
    <script is:inline>
      // The docs' theme (system, light or dark), shared with the docs pages through
      // `jacket-docs-theme`. `data-ide-theme` pins the workspace's colour scheme;
      // with `system` it follows the browser.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var saved = localStorage.getItem('jacket-docs-theme');
          if (saved === 'light' || saved === 'dark') root.setAttribute('data-theme', saved);
        } catch (error) {
          // Blocked storage: the system theme stays.
        }
        function pin() {
          var theme = root.getAttribute('data-theme');
          if (theme === 'light' || theme === 'dark') root.setAttribute('data-ide-theme', theme);
          else root.removeAttribute('data-ide-theme');
        }
        pin();
        new MutationObserver(pin).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
      })();
    </script>
    <script is:inline src="/docs/jacket/assets/site.js" defer></script>
  </head>
  <body data-base={base}>
    <header class="top">
      <div class="top-in">
        <a class="logo" href={base} aria-label="Jacket API documentation">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" role="img" aria-label="Jacket" viewBox="0 0 16 16"
            ><path
              fill="#ff8e78"
              fill-rule="evenodd"
              d="M4 1.5h8A2.5 2.5 0 0 1 14.5 4v8a2.5 2.5 0 0 1-2.5 2.5H4A2.5 2.5 0 0 1 1.5 12V4A2.5 2.5 0 0 1 4 1.5z M8.9 4.25h1.85V9.4a2.75 2.75 0 0 1-5.5 0h1.85a.9.9 0 0 0 1.8 0z"
            ></path></svg
          >
          <span class="wordmark">jacket</span>
        </a>
        <div class="search-wrap js-only">
          <label class="sr" for="q">Search the docs</label>
          <div class="search">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              ><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg
            >
            <input
              id="q"
              type="search"
              placeholder="Search by name or signature"
              autocomplete="off"
              spellcheck="false"
              role="combobox"
              aria-expanded="false"
              aria-controls="results"
              aria-autocomplete="list"
            />
            <kbd>/</kbd>
          </div>
          <div id="results" role="listbox" aria-label="Search results" hidden></div>
        </div>
        <nav class="site-nav" aria-label="Site">
          <a href={base}>API</a>
          <a href={`${base}tools/`}>Tools</a>
          <a href={JACKET_PLAYGROUND} aria-current="page">Playground</a>
          {
            version && (
              <div class="ver">
                <button type="button" id="ver" aria-haspopup="true" aria-expanded="false" aria-controls="ver-menu" disabled>
                  {version}
                  <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </button>
                <div id="ver-menu" class="ver-menu" role="menu" hidden />
              </div>
            )
          }
          <button
            type="button"
            id="theme"
            class="icon-btn js-only"
            aria-label="Theme: system (click to change)"
            title="Theme: system (click to change)"
          >
            <svg class="i-system" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              ><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg
            >
            <svg class="i-light" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              ><circle cx="12" cy="12" r="4"></circle><path
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
              ></path></svg
            >
            <svg class="i-dark" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg
            >
          </button>
          <a class="icon-btn" href="https://github.com/matteopolak/jacket" aria-label="GitHub repository" title="GitHub repository">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"
              ><path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            >
          </a>
        </nav>
      </div>
    </header>
    <main class="docs-playground" data-playground-page={id} data-demo-state="loading">
      <h1 class="sr">{demo.title}</h1>
      <CodeWorkspace client:load language={id} mode="docs" {...workspace} />
    </main>

    <script>
      import { initializePlaygroundPage } from '../../../lib/playground-page';

      initializePlaygroundPage();
    </script>
  </body>
</html>

<style is:global>
  /*
   * The docs' header (crates/jacket/src/doc/assets/site.css in matteopolak/jacket),
   * scoped to this page. Colours are `light-dark()` pairs, so they follow the
   * page's colour scheme: the system's, or the one the theme button picked.
   */
  html.jacket-docs-page {
    --jd-bg: light-dark(#fafafa, #1b1b1f);
    --jd-glass: light-dark(rgb(250 250 250 / 0.9), rgb(27 27 31 / 0.88));
    --jd-surface: light-dark(#fdfdfd, #1e1e22);
    --jd-sunken: light-dark(#f3f3f5, #161619);
    --jd-fg: light-dark(#2f2f35, #d4d4d8);
    --jd-fg2: light-dark(#56565e, #b0b0b8);
    --jd-muted: light-dark(#6a6a74, #8f8f98);
    --jd-border: light-dark(#ebebee, #2a2a2f);
    --jd-hair: light-dark(#f1f1f3, #242428);
    --jd-link: light-dark(#4a63c8, #a1abf0);
    --jd-sel: light-dark(#f0f2fa, #262a40);
    --jd-type: light-dark(#36766f, #7fbfb3);
    --jd-shadow: light-dark(rgb(24 24 27 / 0.08), rgb(0 0 0 / 0.4));
    --jd-sans: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
    --jd-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;

    height: 100%;
    overflow: hidden;
    color-scheme: light dark;
    scrollbar-gutter: auto;
  }

  html.jacket-docs-page[data-theme='light'] {
    color-scheme: light;
  }

  html.jacket-docs-page[data-theme='dark'] {
    color-scheme: dark;
  }

  .jacket-docs-page body {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    overflow: hidden;
    color: var(--jd-fg);
    background: var(--jd-bg);
    font: 15.5px/1.7 var(--jd-sans);
  }

  .jacket-docs-page .sr {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  html.jacket-docs-page:not(.js) .js-only {
    display: none !important;
  }

  .jacket-docs-page :where(.top, #results, .ver-menu) a {
    color: var(--jd-link);
    text-decoration: none;
  }

  .jacket-docs-page .top :focus-visible {
    outline: 2px solid var(--jd-link);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Header */
  .jacket-docs-page .top {
    position: relative;
    z-index: 5;
    flex: none;
    background: var(--jd-glass);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--jd-border);
  }

  .jacket-docs-page .top-in {
    max-width: 1520px;
    margin: 0 auto;
    padding: 10px 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  .jacket-docs-page .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding-left: 10px;
    color: var(--jd-fg);
  }

  .jacket-docs-page .wordmark {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .jacket-docs-page .ver {
    position: relative;
  }

  .jacket-docs-page #ver {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font: inherit;
    color: var(--jd-fg2);
    background: none;
    border: 0;
    padding: 4px 0;
    cursor: pointer;
  }

  .jacket-docs-page #ver:disabled {
    cursor: default;
  }

  .jacket-docs-page #ver:disabled svg {
    display: none;
  }

  .jacket-docs-page #ver:not(:disabled):hover,
  .jacket-docs-page #ver[aria-expanded='true'] {
    color: var(--jd-fg);
  }

  .jacket-docs-page #ver svg {
    color: var(--jd-muted);
    transition: transform 0.15s;
  }

  .jacket-docs-page #ver[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .jacket-docs-page .ver-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: -12px;
    min-width: 160px;
    padding: 6px;
    background: var(--jd-surface);
    border: 1px solid var(--jd-border);
    border-radius: 10px;
    box-shadow: 0 12px 32px var(--jd-shadow);
    z-index: 7;
  }

  .jacket-docs-page .ver-menu[hidden] {
    display: none;
  }

  .jacket-docs-page .ver-menu a {
    display: block;
    padding: 6px 10px;
    border-radius: 6px;
    color: var(--jd-fg2);
    white-space: nowrap;
  }

  .jacket-docs-page .ver-menu a:hover {
    color: var(--jd-fg);
    background: var(--jd-sel);
  }

  .jacket-docs-page .ver-menu a[aria-current='true'] {
    color: var(--jd-link);
  }

  .jacket-docs-page .search-wrap {
    flex: 1 1 320px;
    position: relative;
    display: flex;
    justify-content: center;
  }

  .jacket-docs-page .search {
    position: relative;
    width: 100%;
    max-width: 560px;
  }

  .jacket-docs-page .search svg {
    position: absolute;
    left: 12px;
    top: 11px;
    color: var(--jd-muted);
    pointer-events: none;
  }

  .jacket-docs-page .search input {
    width: 100%;
    font: 14px/1.7 var(--jd-sans);
    color: var(--jd-fg);
    padding: 8px 40px 8px 36px;
    border: 1px solid var(--jd-border);
    border-radius: 10px;
    background: var(--jd-surface);
  }

  .jacket-docs-page .search input:focus {
    border-color: var(--jd-link);
    outline: none;
    box-shadow: 0 0 0 3px var(--jd-sel);
  }

  .jacket-docs-page kbd {
    font-family: var(--jd-mono);
    font-size: 12px;
    color: var(--jd-muted);
    border: 1px solid var(--jd-border);
    border-bottom-width: 2px;
    border-radius: 5px;
    padding: 0 6px;
    background: var(--jd-sunken);
  }

  .jacket-docs-page .search kbd {
    position: absolute;
    right: 10px;
    top: 7px;
  }

  .jacket-docs-page #results {
    position: absolute;
    top: 46px;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 640px;
    max-height: min(70vh, 32rem);
    overflow-y: auto;
    background: var(--jd-surface);
    border: 1px solid var(--jd-border);
    border-radius: 12px;
    box-shadow: 0 12px 32px var(--jd-shadow);
    padding: 6px;
    z-index: 6;
    font-size: 15.5px;
  }

  .jacket-docs-page #results[hidden] {
    display: none;
  }

  .jacket-docs-page #results .hit {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border-radius: 8px;
    color: var(--jd-fg);
    cursor: pointer;
  }

  .jacket-docs-page #results .hit[aria-selected='true'] {
    background: var(--jd-sel);
  }

  .jacket-docs-page #results .kind {
    font-size: 11px;
    font-weight: 600;
    color: var(--jd-muted);
    width: 40px;
    flex: none;
  }

  .jacket-docs-page #results .path {
    font-family: var(--jd-mono);
    font-size: 13.5px;
    flex: none;
  }

  .jacket-docs-page #results .sig {
    flex: 1 1 auto;
    text-align: right;
    font-family: var(--jd-mono);
    font-size: 12px;
    color: var(--jd-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .jacket-docs-page #results :is(.pname, .sig .pname) {
    color: var(--jd-fg);
    font-weight: 500;
  }

  .jacket-docs-page #results .ty {
    color: var(--jd-type);
  }

  .jacket-docs-page #results .empty {
    padding: 10px;
    color: var(--jd-muted);
    font-size: 14px;
  }

  .jacket-docs-page #results .tips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    padding: 8px 10px 4px;
    border-top: 1px solid var(--jd-hair);
    margin-top: 4px;
    font-size: 12px;
    color: var(--jd-muted);
  }

  .jacket-docs-page .site-nav {
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: 14px;
    font-weight: 500;
  }

  .jacket-docs-page .site-nav > a {
    color: var(--jd-fg2);
  }

  .jacket-docs-page .site-nav > a:hover {
    text-decoration: underline;
  }

  .jacket-docs-page .site-nav > a[aria-current='page'] {
    color: var(--jd-fg);
  }

  .jacket-docs-page .icon-btn {
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--jd-border);
    border-radius: 8px;
    background: var(--jd-surface);
    color: var(--jd-fg2) !important;
    cursor: pointer;
  }

  .jacket-docs-page .icon-btn .i-light,
  .jacket-docs-page .icon-btn .i-dark,
  html.jacket-docs-page[data-theme='light'] .icon-btn .i-system,
  html.jacket-docs-page[data-theme='dark'] .icon-btn .i-system {
    display: none;
  }

  html.jacket-docs-page[data-theme='light'] .icon-btn .i-light,
  html.jacket-docs-page[data-theme='dark'] .icon-btn .i-dark {
    display: block;
  }

  /* The workspace: a card under the header, the docs' content width. */
  .jacket-docs-page .docs-playground {
    flex: 1 1 auto;
    width: 100%;
    max-width: 1520px;
    min-height: 0;
    margin: 0 auto;
    padding: 20px 32px 28px;
  }

  @media (max-width: 899px) {
    .jacket-docs-page .top-in {
      padding: 10px 16px;
    }

    .jacket-docs-page .logo {
      padding-left: 0;
    }

    .jacket-docs-page .docs-playground {
      padding: 12px 16px 16px;
    }
  }

  @media (max-width: 599px) {
    .jacket-docs-page .site-nav {
      gap: 14px;
      flex-wrap: wrap;
    }

    .jacket-docs-page .search-wrap {
      order: 5;
      flex-basis: 100%;
    }

    .jacket-docs-page #results .sig {
      display: none;
    }
  }

  /* Phones: the workspace takes the whole width under the header. */
  @media (max-width: 42rem) {
    .jacket-docs-page .docs-playground {
      padding: 0;
    }
  }
</style>
