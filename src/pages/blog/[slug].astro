---
import { render } from 'astro:content';
import DraftBadge from '../../components/DraftBadge.astro';
import { getBlogEntries } from '../../lib/content';
import Layout from '../../layouts/Layout.astro';
import BlogToc from '../../components/svelte/BlogToc.svelte';
import { slugOf } from '../../lib/content/format';
import LineChart from '../../components/charts/LineChart.astro';
import AreaChart from '../../components/charts/AreaChart.astro';
import BarChart from '../../components/charts/BarChart.astro';
import Timeline from '../../components/charts/Timeline.astro';
import StatGrid from '../../components/charts/StatGrid.astro';
import Playground from '../../components/Playground.astro';
import Callout from '../../components/charts/Callout.astro';

// Available in every MDX post without an import (docs/blog-charts.md).
const mdxComponents = { LineChart, AreaChart, BarChart, Timeline, StatGrid, Callout, Aside: Callout, Playground };

export async function getStaticPaths() {
  // Drafts are only in the collection in dev (see isVisiblePost).
  const posts = await getBlogEntries();
  return posts.map((post) => ({
      params: { slug: slugOf(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const isDraft = post.data.published === false;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.date.toISOString()}
  noindex={isDraft}
>
  <header class="article-header">
    {isDraft && <p><DraftBadge /></p>}
    <h1>{post.data.title}</h1>
    <time class="article-date" datetime={post.data.date.toISOString()}>
      {
        post.data.date.toLocaleDateString('en-CA', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })
      }
    </time>
  </header>
  <div class="article-layout">
    <article class="prose">
      <Content components={mdxComponents} />
    </article>
    <BlogToc client:idle headings={headings} />
  </div>
</Layout>

<script>
  // Bundled scripts run once; re-check charts after each ClientRouter navigation.
  document.addEventListener('astro:page-load', () => {
    if (document.querySelector('[data-chart-data]')) {
      void import('../../lib/charts/data-dialog').then((m) => m.enhanceChartData());
    }
  });
</script>
