---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogToc from '../../components/svelte/BlogToc.svelte';
import { slugOf } from '../../lib/content/format';
import LineChart from '../../components/charts/LineChart.astro';
import AreaChart from '../../components/charts/AreaChart.astro';
import BarChart from '../../components/charts/BarChart.astro';
import Timeline from '../../components/charts/Timeline.astro';
import StatGrid from '../../components/charts/StatGrid.astro';
import Callout from '../../components/charts/Callout.astro';

// Available in every MDX post without an import (docs/blog-charts.md).
const mdxComponents = { LineChart, AreaChart, BarChart, Timeline, StatGrid, Callout, Aside: Callout };

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => post.data.published !== false)
    .map((post) => ({
      params: { slug: slugOf(post.id) },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.date.toISOString()}
>
  <header class="article-header">
    <h1>{post.data.title}</h1>
    <time class="article-date" datetime={post.data.date.toISOString()}>
      {
        post.data.date.toLocaleDateString('en-CA', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })
      }
    </time>
  </header>
  <div class="article-layout">
    <article class="prose">
      <Content components={mdxComponents} />
    </article>
    <BlogToc client:idle headings={headings} />
  </div>
</Layout>

<script>
  if (document.querySelector('lodestone-game')) {
    void import('../../lib/lodestone-game');
  }
</script>
