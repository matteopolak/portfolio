---
import Layout from '../../layouts/Layout.astro';
import { getPageMeta, getPosts } from '../../lib/content';

const posts = await getPosts();
const meta = getPageMeta('/blog');
---

<Layout title={meta.title} description={meta.description}>
  <header class="page-intro">
    <span class="page-intro__index page-intro__index--blog" aria-hidden="true"></span>
    <h1>{meta.heading}</h1>
  </header>
  <ol class="editorial-list">
    {
      posts.map((post, index) => (
        <li class="editorial-item">
          <span class="editorial-item__number">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div>
            <h2 class="editorial-item__heading">
              <a
                class="editorial-item__title"
                href={post.path}
                data-astro-history="push"
              >
                {post.title}
              </a>
            </h2>
            {post.description && (
              <p class="editorial-item__description">{post.description}</p>
            )}
          </div>
          <time
            class="editorial-item__aside"
            datetime={post.date}
          >
            {new Date(post.date).toLocaleDateString('en-CA', {
              year: 'numeric',
              month: 'short',
              day: '2-digit',
              timeZone: 'UTC',
            })}
          </time>
        </li>
      ))
    }
  </ol>
</Layout>
