---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.published !== false)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function slug(id: string) {
  return id.replace(/\.md$/, '');
}
---

<Layout title="Blog" description="Writing about systems, software, and things learned while building.">
  <header class="page-intro">
    <span class="page-intro__index">02</span>
    <h1>Stuff I wrote</h1>
  </header>
  <ol class="editorial-list">
    {
      posts.map((post, index) => (
        <li class="editorial-item">
          <span class="editorial-item__number">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div>
            <h2 class="editorial-item__heading">
              <a class="editorial-item__title" href={`/blog/${slug(post.id)}`}>
                {post.data.title}
              </a>
            </h2>
            {post.data.description && (
              <p class="editorial-item__description">{post.data.description}</p>
            )}
          </div>
          <time
            class="editorial-item__aside"
            datetime={post.data.date.toISOString()}
          >
            {post.data.date.toLocaleDateString('en-CA', {
              year: 'numeric',
              month: 'short',
              day: '2-digit',
            })}
          </time>
        </li>
      ))
    }
  </ol>
</Layout>
