---
/*
 * The Jacket playground moved into the docs. public/_redirects sends
 * /playground/jacket there with a 301; this page covers `astro dev` and any
 * host that serves the file first. Browsers keep the fragment across both
 * (`#code=…` program links and `#lib/math.jai` file links).
 */
import { JACKET_PLAYGROUND } from '../../data/code-demos';

const target = new URL(JACKET_PLAYGROUND, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${JACKET_PLAYGROUND}`} />
    <link rel="canonical" href={target} />
    <title>Jacket playground</title>
    <script
      is:inline
      set:html={`location.replace(${JSON.stringify(JACKET_PLAYGROUND)} + location.search + location.hash);`}
    />
  </head>
  <body>
    <p>The Jacket playground moved to <a href={JACKET_PLAYGROUND}>{target}</a>.</p>
  </body>
</html>
