---
import '../styles/global.css';
import Head from '../components/Head.astro';
import Nav from '../components/Nav.astro';
import BauhausField from '../components/BauhausField.astro';
import { ClientRouter } from 'astro:transitions';

import config from '../lib/config';
import { canonicalPathname } from '../lib/urls';
import { documentTitle as buildDocumentTitle } from '../data/pages';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  /** Adds `noindex` (draft posts in dev). */
  noindex?: boolean;
}

const { title, description, type, publishedTime, noindex } = Astro.props;
const isHome = canonicalPathname(Astro.url.pathname) === '/';
const documentTitle = buildDocumentTitle(config.name, title, isHome);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <ClientRouter />
    <Head
      title={documentTitle}
      pageTitle={title}
      description={description}
      type={type}
      publishedTime={publishedTime}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <BauhausField showHero={!isHome} />
      <Nav />
      <main id="main" class="site-main" tabindex="-1">
        <slot />
      </main>
    </div>
    <script>
      // The demo dialogs only exist on some pages; the module drags in the
      // Lodestone engine and every demo runtime, so it loads only when a page
      // has a dialog (or has had one, so its listeners are cleaned up).
      let actions: Promise<typeof import('../lib/project-actions')> | undefined;
      const syncProjectActions = async () => {
        if (!actions && !document.querySelector('dialog[data-project-demo]'))
          return;
        actions ??= import('../lib/project-actions');
        (await actions).initializeProjectActions();
      };

      document.addEventListener('astro:page-load', syncProjectActions);
      void syncProjectActions();
    </script>
  </body>
</html>
