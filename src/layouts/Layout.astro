---
import '../styles/global.css';
import Head from '../components/Head.astro';
import Nav from '../components/Nav.astro';
import BauhausField from '../components/BauhausField.astro';
import { ClientRouter } from 'astro:transitions';

import config from '../lib/config';
import { canonicalPathname } from '../lib/urls';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const { title, description, type, publishedTime } = Astro.props;
const isHome = canonicalPathname(Astro.url.pathname) === '/';
const documentTitle = isHome ? `${config.name} — Software Engineer` : `${title} — ${config.name}`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <ClientRouter />
    <Head
      title={documentTitle}
      pageTitle={title}
      description={description}
      type={type}
      publishedTime={publishedTime}
    />
  </head>
  <body>
    <div class="site-shell">
      <BauhausField showHero={!isHome} />
      <Nav />
      <main class="site-main">
        <slot />
      </main>
    </div>
    <script>
      import '../lib/blog-toc';
    </script>
  </body>
</html>
