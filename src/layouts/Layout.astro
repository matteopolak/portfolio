---
import '../styles/global.css';
import Head from '../components/Head.astro';
import Nav from '../components/Nav.astro';
import BauhausField from '../components/BauhausField.astro';
import { ClientRouter } from 'astro:transitions';

import config from '../lib/config';
import { canonicalPathname } from '../lib/urls';
import { documentTitle as buildDocumentTitle } from '../data/pages';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  /** Adds `noindex` (draft posts in dev). */
  noindex?: boolean;
}

const { title, description, type, publishedTime, noindex } = Astro.props;
const isHome = canonicalPathname(Astro.url.pathname) === '/';
const documentTitle = buildDocumentTitle(config.name, title, isHome);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <ClientRouter />
    <Head
      title={documentTitle}
      pageTitle={title}
      description={description}
      type={type}
      publishedTime={publishedTime}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <BauhausField showHero={!isHome} />
      <Nav />
      <main id="main" class="site-main" tabindex="-1">
        <slot />
      </main>
    </div>
    <script>
      import { initializeProjectActions } from '../lib/project-actions';

      document.addEventListener('astro:page-load', initializeProjectActions);
      initializeProjectActions();
    </script>
  </body>
</html>
