---
import '../styles/global.css';
import Head from '../components/Head.astro';
import config from '../lib/config';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light" class="playground-document">
  <head>
    <!-- No ClientRouter: playground links use full loads, so every visit starts a fresh runtime. -->
    <Head title={`${title} — ${config.name}`} pageTitle={title} description={description} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html.playground-document {
    height: 100%;
    overflow: hidden;
    scrollbar-gutter: auto;
  }

  html.playground-document body {
    height: 100%;
    margin: 0;
    overflow: hidden;
    /* The workspace's own page colour (the Jacket docs' background), light or dark with the system. */
    background: #fafafa;
  }

  @media (prefers-color-scheme: dark) {
    html.playground-document body {
      background: #1b1b1f;
    }
  }
</style>
