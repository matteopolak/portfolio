# The Jai playground moved when the project was renamed to Jacket. Browsers keep
# the #file fragment across the redirect, so deep links still open their file.
/playground/jai /playground/jacket 301
/playground/jai.html /playground/jacket 301
# The Jacket playground briefly lived inside the API docs. Fragments
# (#code=…, #lib/math.jai) survive the redirect.
/docs/jacket/playground /playground/jacket 301
/docs/jacket/playground.html /playground/jacket 301
# The API docs moved to their own site; the rest of the path is kept. These
# come after the playground lines because the first match wins.
/docs/jacket https://jacket.matteopolak.com/ 301
/docs/jacket/* https://jacket.matteopolak.com/:splat 301
