{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "predev": "pnpm generate:favicons && pnpm sync:web-assets",
    "dev": "astro dev",
    "prebuild": "pnpm generate:favicons && pnpm sync:web-assets",
    "build": "astro build",
    "generate:favicons": "node scripts/generate-favicons.ts",
    "sync:web-assets": "node scripts/sync-lodestone-web.ts && node scripts/sync-quasi-web.ts && node scripts/sync-baerscript-web.ts && node scripts/sync-jai-web.ts",
    "resume": "typst compile --root . resume/resume.typ --font-path resume/fonts public/resume.pdf",
    "preview": "astro preview",
    "test:lodestone": "node --test tests/lodestone/*.test.ts",
    "check": "astro check",
    "test:jai": "node --test tests/jai/*.test.ts && python3 -m unittest discover -s tests/jai -p 'test_*.py'",
    "astro": "astro",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@lezer/highlight": "1.2.4",
    "@lucide/astro": "^1.48.0",
    "@replit/codemirror-vim": "6.4.0",
    "@shikijs/transformers": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "astro": "^7.3.5",
    "daisyui": "^5.7.46",
    "dompurify": "3.4.16",
    "marked": "18.0.14",
    "prismjs": "^1.30.0",
    "smol-toml": "^1.9.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "24.19.0",
    "eslint-plugin-astro": "^3.2.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "pdfjs-dist": "^6.3.289",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
