{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "predev": "pnpm generate:favicons && pnpm sync:web-assets",
    "dev": "astro dev",
    "prebuild": "pnpm generate:favicons && pnpm sync:web-assets",
    "build": "astro build",
    "generate:favicons": "node scripts/generate-favicons.ts",
    "sync:web-assets": "node scripts/sync-lodestone-web.ts && node scripts/sync-quasi-web.ts && node scripts/sync-baerscript-web.ts && node scripts/sync-jai-web.ts",
    "resume": "typst compile --root . resume/resume.typ --font-path resume/fonts public/resume.pdf",
    "preview": "astro preview",
    "test:lodestone": "node --test tests/lodestone/*.test.ts",
    "check": "astro check",
    "test:jai": "node --test tests/jai/*.test.ts && python3 -m unittest discover -s tests/jai -p 'test_*.py'",
    "astro": "astro",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.18.6",
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.11.0",
    "@codemirror/lint": "6.8.5",
    "@codemirror/search": "6.5.10",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.36.5",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@lezer/highlight": "1.2.1",
    "@lucide/astro": "^0.577.0",
    "@replit/codemirror-vim": "6.4.0",
    "@shikijs/transformers": "^4.0.2",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.0.7",
    "daisyui": "^5.5.19",
    "dompurify": "3.4.16",
    "marked": "18.0.14",
    "prismjs": "^1.30.0",
    "smol-toml": "^1.6.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint-plugin-astro": "^1.6.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "pdfjs-dist": "^6.1.200",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.1"
  }
}
